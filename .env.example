CURSOR_API_KEY=
APP_PASSWORD=rcgcursordemo
# Set true only if write agents should push GitHub PRs to the fleet repos.
OPEN_REAL_PRS=false
# Force cloud (hosted) or local Cursor agents. Default: cloud on Vercel, local otherwise.
# CURSOR_RUNTIME=cloud
# Optional. Resolves fleet baseline_tag (often a tag, not a branch) to a commit SHA for cloud agents.
# Required for private GitHub repos; public sample repos work unauthenticated.
# GITHUB_TOKEN=
