{
  "name": "command-center",
  "version": "0.1.0",
  "private": true,
  "description": "Spec Migrator — agentic OpenAPI breaking-change pipeline on the Cursor SDK",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/dashboard.ts",
    "pipeline": "tsx src/cli.ts",
    "dashboard": "tsx src/dashboard.ts",
    "assert:fields": "tsx src/assert-no-hardcoded-breaks.ts",
    "reset": "bash reset.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.28",
    "@vercel/functions": "^3.4.3",
    "express": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
