node_modules/
dist/
.vercel
.env*.local
.DS_Store
*.log

# Run artifacts — regenerated by the pipeline; never commit a run.
state/*
!state/.gitkeep

# Fresh clones at baseline-v2. Never reuse the sibling working trees
# under cursor_sdk_project/; those are the author's copies, not the fleet.
workspaces/*
!workspaces/.gitkeep
